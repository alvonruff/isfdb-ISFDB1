#
# Get the date the database was compiled, and the whatsnew date.
#
DATE=`cat ../dbase.compiled/.DATE`
WHATSNEW=`grep "<dl><dt>" whatsnew_HTML | awk '{ print $2, $3}'`
COPYS=`cat COPYRIGHT`

#
# Modify the special files. These files contain POST/GET requests
# to the database which need to be resolved.
#
echo $3 > method.tmp
for i in $SPECIAL_LIST
do
	sed -e "s|DBASELOC|$2|g" -e "s|HTMLBASE|$1|g" -e "s|COPYRIGHT|$COPYS|g" "$i"_HTML  > $i.html
done
rm -f method.tmp

#
# Do the main page first. This is treated differently from the other 
# pages as it has to have the DATE and WHATSNEW dates altered.
#
cat sfdbase_HTML | sed -e "s|DBASELOC|$2|g" -e "s|HTMLBASE|$1|g" -e "s|DBASEDATE|$DATE|g" -e "s|DBASEWHATSNEW|$WHATSNEW|g" -e "s|COPYRIGHT|$COPYS|g" > sfdbase.html
cp sfdbase.html index.html
#

#
# Modify the database and html locations in the rest of the files
#
for i in $HTMLLIST
do
	sed -e "s|DBASELOC|$2|g" -e "s|HTMLBASE|$1|g" -e "s|COPYRIGHT|$COPYS|g" "$i"_HTML  > $i.html
done

chmod 666 *.html
